{
	"$schema": "https://biomejs.dev/schemas/2.4.13/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"enabled": true,
			"quoteStyle": "double",
			"quoteProperties": "preserve",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"trailingCommas": "none"
		}
	},
	"css": {
		"parser": {
			"cssModules": false,
			"tailwindDirectives": true
		},
		"formatter": {
			"enabled": false
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "off"
			},
			"suspicious": {
				"noArrayIndexKey": "off"
			},
			"performance": {
				"noImgElement": "off"
			},
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"nursery": {
				"useSortedClasses": "off"
			},
			"a11y": {
				"noLabelWithoutControl": "off",
				"useButtonType": "off",
				"noStaticElementInteractions": "off",
				"useKeyWithClickEvents": "off",
				"noSvgWithoutTitle": "off",
				"useSemanticElements": "off",
				"useMediaCaption": "off",
				"noAutofocus": "off",
				"useAriaPropsSupportedByRole": "off",
				"useFocusableInteractive": "off",
				"useAriaPropsForRole": "off",
				"noRedundantAlt": "off",
				"noNoninteractiveTabindex": "off"
			}
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/dist-ssr",
			"!tmp",
			"!.codebase-memory",
			"!src-tauri/target",
			"!src-tauri/gen",
			"!pnpm-lock.yaml",
			"!public",
			"!plans",
			"!src/bindings",
			"!src-tauri/crates/proxy-core/tests/compatibilidad",
			"!src-tauri/crates/mesa/tests/catalogo",
			"!src/stores/__tests__/fixtures",
			"!src/index.css",
			"!src/themes.css",
			"!src/fonts.css",
			"!src/styles"
		]
	}
}
