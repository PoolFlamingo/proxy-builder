{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["scripts/**/*.{ts,mjs,js}", "src/**/*.test.{ts,tsx}"],
	"project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs,js}"],
	"rules": {
		"exports": "off",
		"nsExports": "off",
		"types": "off",
		"nsTypes": "off",
		"enumMembers": "off",
		"duplicates": "off"
	},
	"ignore": ["src/bindings/**"],
	"ignoreDependencies": ["tw-animate-css", "tailwindcss", "@iconify/json"],
	"ignoreBinaries": ["rustfmt", "inkscape"],
	"ignoreExportsUsedInFile": {
		"interface": true,
		"type": true
	}
}
