{
	"name": "proxy-builder",
	"private": true,
	"version": "2.5.5",
	"type": "module",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"prepare": "husky",
		"format": "biome format --write .",
		"bindings": "cargo test --manifest-path src-tauri/Cargo.toml --workspace export_bindings",
		"check": "pnpm run check:tipos && pnpm run test && pnpm run check:biome && pnpm run --silent check:title && pnpm run --silent idiomas && pnpm run check:knip",
		"check:biome": "biome check .",
		"check:knip": "knip",
		"check:tipos": "tsc --noEmit",
		"check:title": "node scripts/sin-title-nativo.mjs",
		"check:rust-fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
		"check:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
		"idiomas": "node scripts/idiomas.mjs",
		"release": "node scripts/release.mjs",
		"test": "vitest run",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.17.0",
		"radix-ui": "^1.5.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-resizable-panels": "^4.11.2",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "^2",
		"@types/node": "^22",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"happy-dom": "^20.14.5",
		"husky": "^9.1.7",
		"knip": "^6.34.0",
		"lint-staged": "^16.2.7",
		"tailwindcss": "^4.3.0",
		"typescript": "~5.8.3",
		"vite": "^7.3.6",
		"vitest": "^5.0.1"
	},
	"engines": {
		"node": ">=22",
		"pnpm": ">=12"
	}
}
