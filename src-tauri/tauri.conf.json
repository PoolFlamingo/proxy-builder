{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Proxy Builder",
	"version": "1.0.0",
	"identifier": "com.estigio.proxybuilder",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Proxy Builder",
				"width": 1440,
				"height": 900,
				"minWidth": 960,
				"minHeight": 640
			}
		],
		"security": {
			"csp": {
				"default-src": "'self'",
				"script-src": "'self'",
				"img-src": "'self' pbimg: http://pbimg.localhost data: blob:",
				"style-src": "'self' 'unsafe-inline'",
				"font-src": "'self' data:",
				"connect-src": "ipc: http://ipc.localhost",
				"object-src": "'none'",
				"base-uri": "'self'",
				"form-action": "'none'"
			},
			"devCsp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"category": "Utility",
		"shortDescription": "Decks proxy de Magic: The Gathering listos para imprimir",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"linux": {
			"deb": {
				"depends": []
			}
		}
	}
}
