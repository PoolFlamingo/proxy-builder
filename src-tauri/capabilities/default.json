{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Permisos de la ventana principal. Nada de `fs`: todo acceso a disco pasa por comandos de Rust.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"core:window:allow-show",
		"core:window:allow-destroy",
		"core:window:allow-set-fullscreen",
		"opener:default",
		"dialog:default",
		"window-state:default"
	]
}
